---
import type { AppearanceFact } from '@/config/content';
import heightIcon from '@/assets/icons/height-svgrepo-com.svg?raw';
import dressIcon from '@/assets/icons/chiffon-dress-svgrepo-com.svg?raw';
import hairIcon from '@/assets/icons/female-hairs-svgrepo-com.svg?raw';

interface Props {
  fact: AppearanceFact;
}

const { fact } = Astro.props;
const { icon, label, value } = fact;

const assetIcons: Partial<Record<AppearanceFact['icon'], string>> = {
  height: heightIcon,
  dress: dressIcon,
  hair: hairIcon,
};

const assetHtml = assetIcons[icon] ?? '';
---

<div class="flex min-w-0 flex-col border-l border-border-strong px-3 py-1 sm:px-4">
  <dt class="flex items-center gap-1.5 text-[0.65rem] font-medium uppercase tracking-[0.14em] text-foreground-muted">
    <span
      class:list={['fact-icon', 'inline-flex', 'h-4', 'w-4', 'shrink-0', 'items-center', 'justify-center', 'text-accent', assetHtml ? 'fact-icon--asset' : '']}
      aria-hidden="true"
    >
      {assetHtml ? (
        <Fragment set:html={assetHtml} />
      ) : icon === 'eyes' ? (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
          <circle cx="12" cy="12" r="2.5" />
        </svg>
      ) : icon === 'license' ? (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <circle cx="9" cy="12" r="2.2" />
          <path d="M14 10.5h4M14 13.5h3" stroke-linecap="round" />
        </svg>
      ) : (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M5 16h14l-1.2-4.2A2 2 0 0 0 15.9 10H8.1a2 2 0 0 0-1.9 1.8L5 16Z" />
          <path d="M7 16v2M17 16v2M8.5 10l1-3h5l1 3" stroke-linecap="round" />
        </svg>
      )}
    </span>
    {label}
  </dt>
  <dd class="mt-1.5 font-display text-base text-foreground sm:text-lg">{value}</dd>
</div>

<style>
  .fact-icon :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }
  .fact-icon--asset :global(svg),
  .fact-icon--asset :global(path),
  .fact-icon--asset :global(rect) {
    fill: currentColor;
  }
</style>
