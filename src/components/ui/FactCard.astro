---
interface Props {
  label: string;
  value: string;
  class?: string;
}

const { label, value, class: className = '' } = Astro.props;
---

<div class={`rounded-xl border border-border bg-card px-4 py-3 ${className}`}>
  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-foreground-subtle">{label}</p>
  <p class="mt-1 font-display text-lg text-foreground">{value}</p>
</div>
