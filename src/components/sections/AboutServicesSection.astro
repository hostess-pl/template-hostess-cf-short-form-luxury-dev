---
import { Image } from 'astro:assets';
import { content, heroImage, getShowStrengthsSection, currentWorkEntries } from '@/config/content';
import Chip from '@/components/ui/Chip.astro';
import PhysicalFact from '@/components/ui/PhysicalFact.astro';
import { locales } from '@/config/site.config';

const physicalLabel: Record<(typeof locales)[number], string> = {
  en: 'Physical profile',
  pl: 'Profil fizyczny',
  es: 'Perfil físico',
};

const strengthsLabel: Record<(typeof locales)[number], string> = {
  en: 'Strengths',
  pl: 'Atuty',
  es: 'Fortalezas',
};

const workLabel: Record<(typeof locales)[number], string> = {
  en: 'Work',
  pl: 'Praca',
  es: 'Trabajo',
};

const hasStrengths = getShowStrengthsSection();
const hasCurrentWork = locales.some((locale) => currentWorkEntries[locale].length > 0);
const hasBody = locales.some((locale) => Boolean(content.about[locale].body));
const hasLanguages = locales.some((locale) => content.languages[locale].length > 0);
const hasPhysical = locales.some((locale) => content.appearanceFacts[locale].length > 0);
const hasEducationBlock = locales.some((locale) => {
  const education = content.about[locale].education;
  return education.degrees.length > 0 || hasCurrentWork;
});
---

<section id="about" data-review-id="about-section" class="border-b border-border py-16 md:py-20 lg:py-24">
  <div class="container">
    <div class="max-w-3xl">
      {locales.map((locale) => (
        <p class="section-label mb-3" data-lang={locale}>{content.aboutServices[locale].title}</p>
      ))}
      <h2 class="font-display text-3xl uppercase tracking-tight text-foreground md:text-5xl">
        {locales.map((locale) => (
          <span data-lang={locale}>{content.aboutServices[locale].heading}</span>
        ))}
      </h2>
      <p data-review-target="about-lead" class="mt-5 text-base leading-relaxed text-foreground-muted md:text-lg">
        {locales.map((locale) => (
          <span data-lang={locale}>{content.about[locale].lead}</span>
        ))}
      </p>
      {hasBody ? (
        <p class="mt-4 text-base leading-relaxed text-foreground-muted">
          {locales.map((locale) => (
            <span data-lang={locale}>{content.about[locale].body}</span>
          ))}
        </p>
      ) : null}

      {hasLanguages ? (
        <div class="mt-6">
          {locales.map((locale) => (
            <div data-lang={locale}>
              <p class="text-[0.65rem] uppercase tracking-[0.2em] text-accent">{content.languagesLabel[locale]}</p>
              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                {content.languages[locale].map((lang) => (
                  <li class="text-sm text-foreground">
                    <span class="font-medium">{lang.name}</span>
                    {lang.level ? <span class="text-foreground-muted"> · {lang.level}</span> : null}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : null}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(260px,0.85fr)] lg:items-start lg:gap-14">
      <div class="min-w-0">
        {hasEducationBlock ? (
          locales.map((locale) => {
            const education = content.about[locale].education;
            if (education.degrees.length === 0 && !hasCurrentWork) return null;
            return (
              <div class="space-y-8" data-lang={locale} data-review-target="about-education">
                {education.degrees.length > 0 ? (
                  <div>
                    <p class="text-[0.65rem] uppercase tracking-[0.2em] text-accent">{education.label}</p>
                    {education.showSharedUniversity && (
                      <p class="mt-2 text-sm text-foreground-muted">{education.university}</p>
                    )}
                    <div class="mt-4 divide-y divide-border border-y border-border">
                      {education.degrees.map((degree) => (
                        <div class="flex items-start justify-between gap-3 py-4" data-review-target={`about-degree-${degree.id}`}>
                          <div class="min-w-0">
                            <p class="font-display text-lg text-foreground">{degree.name}</p>
                            {!education.showSharedUniversity && degree.university && (
                              <p class="mt-0.5 text-sm text-foreground-muted">{degree.university}</p>
                            )}
                          </div>
                          {degree.year ? <p class="shrink-0 text-sm text-accent">{degree.year}</p> : null}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : null}
                {hasCurrentWork ? (
                  <div>
                    <p class="text-[0.65rem] uppercase tracking-[0.2em] text-accent">{workLabel[locale]}</p>
                    <div class="mt-4 divide-y divide-border border-y border-border">
                      {currentWorkEntries[locale].map((entry) => (
                        <div class="flex items-start justify-between gap-3 py-4">
                          <p class="font-display text-lg text-foreground">{entry.name}</p>
                          {entry.year ? <p class="shrink-0 text-sm text-accent">{entry.year}</p> : null}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : null}
              </div>
            );
          })
        ) : null}
      </div>

      <div class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
        <Image
          src={heroImage}
          alt=""
          widths={[480, 720, 960]}
          sizes="(max-width: 1024px) 90vw, 36vw"
          class="aspect-[4/5] w-full object-cover object-[center_18%]"
          loading="lazy"
        />
      </div>
    </div>

    {hasPhysical ? (
      <div class="mt-12 border-t border-border pt-8">
        {locales.map((locale) => {
          const facts = content.appearanceFacts[locale];
          if (facts.length === 0) return null;
          return (
            <aside
              data-lang={locale}
              data-review-target="about-physical"
              aria-label={physicalLabel[locale]}
            >
              <p class="text-[0.65rem] uppercase tracking-[0.22em] text-accent">{physicalLabel[locale]}</p>
              <dl class="mt-5 grid grid-cols-2 gap-0 sm:grid-cols-3 lg:grid-cols-6">
                {facts.map((fact) => (
                  <PhysicalFact fact={fact} />
                ))}
              </dl>
            </aside>
          );
        })}
      </div>
    ) : null}

    {hasStrengths ? (
      <div class="mt-10 border-t border-border pt-8">
        {locales.map((locale) => (
          <p class="text-center text-[0.65rem] uppercase tracking-[0.22em] text-foreground-subtle" data-lang={locale}>
            {strengthsLabel[locale]}
          </p>
        ))}
        {locales.map((locale) => (
          <div class="mt-4 flex flex-wrap items-center justify-center gap-2.5" data-lang={locale}>
            {content.strengths[locale].map((strength) => (
              <Chip text={strength} />
            ))}
          </div>
        ))}
      </div>
    ) : null}
  </div>
</section>
