---
import { Image } from 'astro:assets';
import { content, heroImage } from '@/config/content';
import { locales } from '@/config/site.config';
---

<section
  id="hero"
  data-review-id="hero-section"
  class="relative min-h-[100svh] overflow-hidden pt-16 draft-aware-hero"
>
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt=""
      widths={[960, 1400, 1920]}
      sizes="100vw"
      class="h-full w-full object-cover object-[center_20%]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-background/80 via-background/55 to-background"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-background/70 via-transparent to-background/40"></div>
  </div>

  <div class="container relative z-10 flex min-h-[calc(100svh-4rem)] flex-col justify-end pb-12 pt-24 md:pb-16 md:pt-28">
    <div class="max-w-3xl">
      {locales.map((locale) => (
        <p class="section-label mb-5" data-lang={locale}>{content.hero[locale].eyebrow}</p>
      ))}

      <h1
        data-review-target="hero-headline"
        class="font-display text-[clamp(2.5rem,7vw,4.75rem)] uppercase leading-[0.95] tracking-tight text-foreground"
      >
        {locales.map((locale) => (
          <span data-lang={locale} class="block">
            {content.hero[locale].useUserHeadline ? (
              content.hero[locale].headline
            ) : (
              <>
                {content.hero[locale].elegantLead}{' '}
                <span class="text-accent italic normal-case">{content.hero[locale].elegantAccent}</span>
                <br />
                <span class="text-foreground">{content.hero[locale].elegantSuffix}</span>
              </>
            )}
          </span>
        ))}
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-foreground-muted md:text-lg">
        {locales.map((locale) => (
          <span data-lang={locale}>
            {content.hero[locale].subheadlineIntro}{' '}
            {content.hero[locale].subheadline}
          </span>
        ))}
      </p>

      <p class="mt-4 text-sm uppercase tracking-[0.22em] text-accent/90">{content.cityRibbon}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        {locales.map((locale) => (
          <a href="#contact" data-review-target="hero-cta-primary" class="luxury-cta" data-lang={locale}>
            {content.hero[locale].cta}
          </a>
        ))}
        {locales.map((locale) => (
          <a href="#work" data-review-target="hero-cta-secondary" class="luxury-cta-ghost" data-lang={locale}>
            {content.hero[locale].ctaSecondary}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-12 border-t border-border-strong/60 pt-6">
      {locales.map((locale) => (
        <dl data-review-target="hero-stats" class="grid grid-cols-4 gap-3 sm:gap-6" data-lang={locale}>
          {content.elegantStats[locale].map((stat) => (
            <div class="min-w-0 text-center sm:text-left">
              <dt class="truncate text-[0.55rem] font-medium uppercase tracking-[0.16em] text-foreground-subtle sm:text-[0.62rem] sm:tracking-[0.24em]">{stat.label}</dt>
              <dd class="mt-1.5 font-display text-lg text-foreground sm:mt-2 sm:text-2xl md:text-3xl">{stat.value}</dd>
            </div>
          ))}
        </dl>
      ))}
    </div>
  </div>
</section>
